# Leave empty to use deterministic, safe local explanation fallback.
OPENAI_API_KEY=
OPENAI_EXPLANATION_MODEL=gpt-5-mini

# Used only by /api/webhooks/razorpay to validate incoming Test Mode webhook signatures.
RAZORPAY_WEBHOOK_SECRET=

# Razorpay Test Mode Checkout. The secret stays server-side; the key ID is safe for Checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Configure these when you run the supplied Supabase migration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used only by your merchant server when it sends hashed checkout signals to Sentinel.
# Never expose this value in a browser or mobile app.
SENTINEL_INGEST_SECRET=
SENTINEL_IP_HASH_SECRET=replace-with-a-long-random-secret
SENTINEL_SIGNAL_HASH_SECRET=replace-with-a-different-long-random-secret
